#!/bin/bash
# BikeClock ESP32 設定ファイル
# 各スクリプトから source コマンドで読み込まれます

#=============================================================================
# シリアルポート設定（必須）
#=============================================================================
# ESP32-S3 SuperMini のシリアルポートを指定してください
# USB-CDC モードでは主に /dev/cu.usbmodem* で認識されます
#
# 設定例:
#   BIKECLOCK_PORT="/dev/cu.usbmodem101"
#   BIKECLOCK_PORT="/dev/cu.usbmodem2101"
#   BIKECLOCK_PORT="/dev/cu.usbserial-XXXX"
#
# 未設定の場合はエラーで終了します
#=============================================================================

BIKECLOCK_PORT="/dev/cu.usbmodemXXXX"

#=============================================================================
# その他の設定（将来の拡張用）
#=============================================================================
