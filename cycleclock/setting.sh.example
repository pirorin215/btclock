#!/bin/bash
# CycleClock 設定ファイル
# 各スクリプトから source コマンドで読み込まれます

#=============================================================================
# シリアルポート設定（必須）
#=============================================================================
# XIAO BLE デバイスのシリアルポートを指定してください
# 自動検出を廃止し、明示的に指定することで、意図しないデバイスへの
# ファームウェア書き込みやログ出力を防ぐためです
#
# 設定例:
#   CYCLECLOCK_PORT="/dev/cu.usbmodem212101"  # 開発共用ポート(親AGENTS.md §8)
#   CYCLECLOCK_PORT="/dev/cu.usbmodem1301"
#
# 未設定の場合はエラーで終了します
#=============================================================================

CYCLECLOCK_PORT="/dev/cu.usbmodemXXXX"
